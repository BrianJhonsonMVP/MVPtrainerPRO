# Supabase public frontend config
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend auth and CORS. Use the same public project credentials; never use service_role here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
PUBLIC_APP_URL=https://app.your-domain.com
# ALLOWED_ORIGINS=https://app.your-domain.com,https://www.your-domain.com
AI_RATE_LIMIT=30
AI_RATE_WINDOW_MS=600000

# Gemini backend config used by server.ts
GEMINI_API_KEY=your-gemini-api-key
# GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-3.5-flash

# Supabase Edge Functions / Stripe config
# Configure these as Supabase secrets, not as frontend VITE variables.
# Web subscriptions (Mercado Pago Peru). Keep these only as Supabase secrets.
MERCADOPAGO_ACCESS_TOKEN=APP_USR_xxx
MERCADOPAGO_WEBHOOK_SECRET=xxx
# Commercial list prices are always expressed in USD.
MVP_PRICE_MONTHLY_USD=14.99
MVP_PRICE_SEMIANNUAL_USD=79.99
MVP_PRICE_YEARLY_USD=149.99
# Mercado Pago Peru may settle the checkout in PEN. Configure the exact local
# amounts shown before confirmation. When charging USD, these may be omitted.
MERCADOPAGO_CHARGE_CURRENCY=PEN
MERCADOPAGO_CHARGE_MONTHLY=
MERCADOPAGO_CHARGE_SEMIANNUAL=
MERCADOPAGO_CHARGE_YEARLY=
# Optional: use pre-created Mercado Pago plans instead of amounts above.
MERCADOPAGO_PLAN_MONTHLY_ID=
MERCADOPAGO_PLAN_SEMIANNUAL_ID=
MERCADOPAGO_PLAN_YEARLY_ID=

# Public production URL and comma-separated browser origins for Edge Functions.
APP_PUBLIC_URL=https://app.mvptrainerpro.com
APP_ALLOWED_ORIGINS=https://app.mvptrainerpro.com

# Mobile subscriptions. Public SDK keys are safe to embed in their store binary.
VITE_REVENUECAT_APPLE_API_KEY=appl_xxx
VITE_REVENUECAT_GOOGLE_API_KEY=goog_xxx
VITE_REVENUECAT_ENTITLEMENT_ID=pro
# Display-only commercial list prices in USD.
VITE_WEB_PRICE_MONTHLY_LABEL=US$ 14.99
VITE_WEB_PRICE_SEMIANNUAL_LABEL=US$ 79.99
VITE_WEB_PRICE_YEARLY_LABEL=US$ 149.99
# Configure this exact value as RevenueCat's Authorization header and a Supabase secret.
REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer_replace_with_a_long_random_secret
