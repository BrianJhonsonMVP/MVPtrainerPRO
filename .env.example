# Supabase public frontend config
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Backend auth and CORS. Use the same public project credentials; never use service_role here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
PUBLIC_APP_URL=https://app.your-domain.com
# ALLOWED_ORIGINS=https://app.your-domain.com,https://www.your-domain.com
AI_RATE_LIMIT=30
AI_RATE_WINDOW_MS=600000

# Gemini backend config used by server.ts
GEMINI_API_KEY=your-gemini-api-key
# GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-3.5-flash

# Supabase Edge Functions / Stripe config
# Configure these as Supabase secrets, not as frontend VITE variables.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_SEMIANNUAL=price_xxx
STRIPE_PRICE_YEARLY=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
