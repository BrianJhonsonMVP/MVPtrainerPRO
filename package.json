{
  "name": "copy-of-mvp-trainer-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "npm run mobile:sync && cap open android",
    "mobile:ios": "npm run mobile:sync && cap open ios",
    "check:mojibake": "node scripts/check-mojibake.mjs",
    "check:launch": "node scripts/check-launch-readiness.mjs",
    "lint": "tsc --noEmit",
    "test:premium": "tsx scripts/verify-premium-stability.ts",
    "start": "node dist/server.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@revenuecat/purchases-capacitor": "^13.4.2",
    "@supabase/supabase-js": "2.112.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "esbuild": "0.28.2",
    "express": "^5.2.1",
    "framer-motion": "^12.39.0",
    "lucide-react": "^0.555.0",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^22.14.0",
    "@types/qrcode": "1.5.5",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "4.23.13",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
